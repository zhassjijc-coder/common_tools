<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:LinkLab.App">
  <Style x:Key="FreePortCombo" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
    <Setter Property="IsEditable" Value="False"/>
    <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
    <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True"/>
    <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling"/>
    <Setter Property="ItemsPanel"><Setter.Value><ItemsPanelTemplate><VirtualizingStackPanel/></ItemsPanelTemplate></Setter.Value></Setter>
    <!-- These non-editable lists contain plain COM-name strings. Bind the display
         directly to SelectedItem: SelectionBoxItem can remain empty while both
         mutually exclusive ItemsSource lists are rebuilt after a failed create. -->
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox">
      <Grid>
        <ToggleButton Focusable="False" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" ClickMode="Press">
          <ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="{DynamicResource Input}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="6"><Path Data="M 0 0 L 4 4 L 8 0" Stroke="{DynamicResource Muted}" StrokeThickness="1.5" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0"/></Border></ControlTemplate></ToggleButton.Template>
        </ToggleButton>
        <ContentPresenter x:Name="Display" Content="{Binding SelectedItem, RelativeSource={RelativeSource TemplatedParent}, Mode=OneWay}" Margin="11,9,30,9" VerticalAlignment="Center" IsHitTestVisible="False"/>
        <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
          <Border Background="{DynamicResource Card}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="6" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="300" Margin="0,3,0,0"><ScrollViewer CanContentScroll="True"><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/></ScrollViewer></Border>
        </Popup>
      </Grid>
      <ControlTemplate.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5"/></Trigger></ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <DataTemplate DataType="{x:Type local:VirtualSerialVm}">
    <ScrollViewer x:Name="VirtualSerialScroll" local:ScrollChain.Enabled="True" CanContentScroll="False" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,8,0">
      <StackPanel>
        <Border Style="{StaticResource CardBorder}" Margin="0,0,0,14">
          <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="210"/></Grid.ColumnDefinitions>
            <StackPanel Margin="0,0,22,0">
              <TextBlock Text="VIRTUAL SERIAL  /  本机串口实验室" Foreground="{DynamicResource VirtualAccent}" FontSize="10" FontWeight="SemiBold"/>
              <TextBlock Text="一对串口，让收发连起来。" FontSize="24" FontWeight="SemiBold" Margin="0,10,0,10"/>
              <TextBlock Text="创建 Windows 可识别的 COM 端口对。A 发送、B 接收；B 发送、A 接收，可供 LinkLab 和其他串口软件使用。" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" LineHeight="21"/>
            </StackPanel>
            <Border Grid.Column="1" Background="{DynamicResource Selected}" CornerRadius="12" Padding="18" VerticalAlignment="Center">
              <StackPanel><TextBlock Text="COM A   ⇄   COM B" FontSize="19" FontWeight="SemiBold" Foreground="{DynamicResource VirtualAccent}" HorizontalAlignment="Center"/><TextBlock Text="主站  →  虚拟连线  →  从站" Foreground="{DynamicResource Muted}" FontSize="11" HorizontalAlignment="Center" Margin="0,10,0,0"/></StackPanel>
            </Border>
          </Grid>
        </Border>
        <Border Style="{StaticResource CardBorder}" Margin="0,0,0,14">
          <StackPanel>
            <TextBlock Text="01  驱动与管理工具" Style="{StaticResource SectionTitle}"/>
            <TextBlock Text="{Binding DriverHint}" Foreground="{DynamicResource VirtualAccent}" FontWeight="SemiBold" Margin="0,0,0,8"/>
            <TextBlock Text="首次使用需单独安装 com0com。请选择 Windows 接受签名的兼容驱动；若被系统阻止，请更换兼容版本。安装工具和 INF 文件需保持在原目录。" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" LineHeight="20" Margin="0,0,0,12"/>
            <Grid IsEnabled="{Binding Idle}"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <TextBox Text="{Binding ToolPath, UpdateSourceTrigger=PropertyChanged}" ToolTip="已安装 com0com 目录内的 setupc.exe 绝对路径" VerticalContentAlignment="Center"/>
              <Button Grid.Column="1" Content="选择 setupc.exe" Command="{Binding BrowseCommand}" Margin="8,0,0,0"/>
              <Button Grid.Column="2" Content="官方驱动下载 ↗" Command="{Binding DownloadCommand}" Margin="8,0,0,0"/>
            </Grid>
            <TextBlock Text="查询和测试以普通权限运行；创建 / 删除时弹出 Windows 管理员授权。" FontSize="11" Foreground="{DynamicResource Muted}" Margin="0,10,0,0" TextWrapping="Wrap"/>
            <TextBlock Text="{Binding DriverRecoveryHint}" Visibility="{Binding DriverBlocked, Converter={StaticResource BoolVisibility}}" Foreground="{DynamicResource ErrorAccent}" Margin="0,12,0,0" TextWrapping="Wrap" LineHeight="21"/>
          </StackPanel>
        </Border>
        <Border Style="{StaticResource CardBorder}" Margin="0,0,0,14">
          <StackPanel>
            <Grid Margin="0,0,0,14"><TextBlock Text="02  创建与管理端口对" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/><Button Content="刷新检测" Command="{Binding RefreshCommand}" IsEnabled="{Binding Idle}" HorizontalAlignment="Right"/></Grid>
            <WrapPanel IsEnabled="{Binding Idle}" Margin="0,0,0,12">
              <StackPanel Width="130" Margin="0,0,12,0"><TextBlock Text="端口 A / 主站" Style="{StaticResource Caption}"/><ComboBox x:Name="CreatePortACombo" ItemsSource="{Binding PortAChoices}" SelectedItem="{Binding PortA, Mode=TwoWay}" Style="{StaticResource FreePortCombo}" AutomationProperties.Name="端口 A / 主站：可用 COM 号"/></StackPanel>
              <TextBlock Text="⇄" Foreground="{DynamicResource VirtualAccent}" FontSize="25" VerticalAlignment="Bottom" Margin="0,0,12,6"/>
              <StackPanel Width="130" Margin="0,0,14,0"><TextBlock Text="端口 B / 从站" Style="{StaticResource Caption}"/><ComboBox x:Name="CreatePortBCombo" ItemsSource="{Binding PortBChoices}" SelectedItem="{Binding PortB, Mode=TwoWay}" Style="{StaticResource FreePortCombo}" AutomationProperties.Name="端口 B / 从站：可用 COM 号"/></StackPanel>
              <Button Content="选择空闲端口" Command="{Binding SuggestCommand}" VerticalAlignment="Bottom" Margin="0,0,8,0"/>
              <Button x:Name="CreatePortPairButton" Content="{Binding CreateLabel}" Command="{Binding CreateCommand}" IsEnabled="{Binding CanCreate}" ToolTip="{Binding DriverRecoveryHint}" Style="{StaticResource PrimaryButton}" VerticalAlignment="Bottom"/>
            </WrapPanel>
            <TextBlock Text="{Binding PortChoiceHint}" Foreground="{DynamicResource Muted}" FontSize="11" TextWrapping="Wrap" LineHeight="18" Margin="0,0,0,12"/>
            <Border Background="{DynamicResource Input}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,12">
              <StackPanel>
                <TextBlock x:Name="PortOperationStatus" Text="{Binding Status}" TextWrapping="Wrap" LineHeight="20" AutomationProperties.LiveSetting="Polite">
                  <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource VirtualAccent}"/><Style.Triggers><DataTrigger Binding="{Binding HasError}" Value="True"><Setter Property="Foreground" Value="{DynamicResource ErrorAccent}"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                </TextBlock>
                <ProgressBar IsIndeterminate="True" Height="3" Margin="0,8,0,0" Visibility="{Binding Busy, Converter={StaticResource BoolVisibility}}"/>
              </StackPanel>
            </Border>
            <DataGrid x:Name="PortPairsTable" ItemsSource="{Binding Pairs}" SelectedItem="{Binding Selected}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" SelectionMode="Single" Height="130" IsEnabled="{Binding Idle}">
              <DataGrid.Columns><DataGridTextColumn Header="编号" Binding="{Binding Id}" Width="65"/><DataGridTextColumn Header="端口 A" Binding="{Binding PortA}" Width="*"/><DataGridTextColumn Header="端口 B" Binding="{Binding PortB}" Width="*"/><DataGridTextColumn Header="状态" Binding="{Binding Status}" Width="2*"/></DataGrid.Columns>
            </DataGrid>
            <Grid Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="端口对在退出应用后保留。空白列表表示尚未检测到端口对；创建时会检查现有及 Windows 保留名称。" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" FontSize="11" VerticalAlignment="Center" Margin="0,0,14,0"/><Button Grid.Column="1" Content="删除所选端口对" Command="{Binding DeleteCommand}" IsEnabled="{Binding CanDeletePair}"/></Grid>
          </StackPanel>
        </Border>
        <Border Style="{StaticResource CardBorder}" Margin="0,0,0,14">
          <StackPanel>
            <TextBlock Text="03  测试与 Modbus RTU 联调" Style="{StaticResource SectionTitle}"/>
            <TextBlock Text="{Binding SelectedLabel}" Foreground="{DynamicResource VirtualAccent}" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,12"/>
            <WrapPanel IsEnabled="{Binding Idle}" Margin="0,0,0,12">
              <StackPanel Width="130" Margin="0,0,12,0"><TextBlock Text="波特率 / 8N1" Style="{StaticResource Caption}"/><TextBox Text="{Binding Baud, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
              <StackPanel Width="100" Margin="0,0,14,0"><TextBlock Text="RTU 站号" Style="{StaticResource Caption}"/><TextBox Text="{Binding Unit, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
              <Button Content="双向收发测试" Command="{Binding DuplexCommand}" IsEnabled="{Binding CanUsePair}" VerticalAlignment="Bottom" Margin="0,0,8,0"/>
              <Button Content="RTU 读写自检" Command="{Binding RtuCommand}" IsEnabled="{Binding CanUsePair}" VerticalAlignment="Bottom"/>
            </WrapPanel>
            <TextBlock Text="测试前请关闭占用端口的连接。RTU 自检会临时启动主从站，验证 03 读取、06 写入与回读；完成后自动释放端口。完整收发报文可在「监视与工具」查看。" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" LineHeight="20" Margin="0,0,0,14"/>
            <WrapPanel><Button Content="应用到 RTU 主站 / 从站" Command="{Binding ConfigureCommand}" IsEnabled="{Binding CanUsePair}" Style="{StaticResource PrimaryButton}" Margin="0,0,8,8"/><Button Content="① 打开设备模拟" Command="{Binding SimulatorCommand}" Margin="0,0,8,8"/><Button Content="② 打开 Modbus 主站" Command="{Binding MasterCommand}" Margin="0,0,0,8"/></WrapPanel>
            <TextBlock Text="手动联调：应用参数 → 在设备模拟中启动从站 → 在主站执行一次读取。默认站号 1、地址 0、数量 3；也可让外部串口工具连接其中一端。" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" LineHeight="20"/>
          </StackPanel>
        </Border>
        <Border Style="{StaticResource CardBorder}"><StackPanel><TextBlock Text="操作日志" Style="{StaticResource SectionTitle}"/><TextBox x:Name="PortLog" Text="{Binding Log, Mode=OneWay}" IsReadOnly="True" TextWrapping="NoWrap" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Height="130" FontFamily="Consolas, Microsoft YaHei UI" FontSize="12"/></StackPanel></Border>
      </StackPanel>
    </ScrollViewer>
  </DataTemplate>
</ResourceDictionary>
