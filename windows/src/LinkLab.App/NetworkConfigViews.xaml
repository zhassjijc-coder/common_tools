<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:LinkLab.App">
  <DataTemplate DataType="{x:Type local:NetworkConfigVm}">
    <ScrollViewer x:Name="NetworkConfigScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,8,0" local:ScrollChain.Enabled="True" CanContentScroll="False">
      <StackPanel>
        <Border Background="{DynamicResource Hero}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="14" Padding="22" Margin="0,0,0,16">
          <StackPanel><TextBlock Text="DEVICE NETWORK  /  从发现设备到配置连接" FontSize="22" FontWeight="SemiBold" /><TextBlock Text="搜索设备、读取参数，集中配置 IP、通信模式与串口。" Foreground="{DynamicResource Muted}" Margin="0,9,0,0" TextWrapping="Wrap" /></StackPanel>
        </Border>
        <Border x:Name="NetworkConfigDiscoveryCard" Style="{StaticResource CardBorder}" Margin="0,0,0,16"><StackPanel>
          <DockPanel Margin="0,0,0,14"><TextBlock Text="01  连接范围与设备发现" Style="{StaticResource SectionTitle}" /><Button Content="刷新网卡" Command="{Binding RefreshInterfacesCommand}" IsEnabled="{Binding Idle}" HorizontalAlignment="Right" /></DockPanel>
          <WrapPanel IsEnabled="{Binding Idle}">
            <StackPanel Width="360" Margin="0,0,14,14"><TextBlock Text="本机 IPv4 网卡" Style="{StaticResource Caption}" /><ComboBox x:Name="NetworkConfigInterfaces" ItemsSource="{Binding Interfaces}" DisplayMemberPath="Display" SelectedValuePath="Address" SelectedValue="{Binding BindAddress}" IsEditable="False" /></StackPanel>
            <StackPanel Width="165" Margin="0,0,14,14"><TextBlock Text="定向查询 IP" Style="{StaticResource Caption}" /><TextBox Text="{Binding Target, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
            <StackPanel Width="105" Margin="0,0,14,14"><TextBlock Text="超时 / ms" Style="{StaticResource Caption}" /><TextBox Text="{Binding Timeout, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
          </WrapPanel>
          <WrapPanel><Button x:Name="NetworkConfigSearch" Content="搜索局域网设备" Command="{Binding SearchCommand}" Style="{StaticResource PrimaryButton}" IsEnabled="{Binding Idle}" /><Button Content="按 IP 查询" Command="{Binding QueryCommand}" IsEnabled="{Binding Idle}" Margin="10,0,0,0" /><Button Content="重读所选设备" Command="{Binding ReadCommand}" IsEnabled="{Binding CanRead}" Margin="10,0,0,0" /><Button x:Name="NetworkConfigRestart" Content="重启所选设备" Command="{Binding RestartCommand}" IsEnabled="{Binding CanRestart}" Margin="10,0,0,0" ToolTip="保留设备当前参数；不会提交编辑区未写入的修改" /></WrapPanel>
          <TextBlock Text="搜索向所选网卡的广播地址发送只读查询；定向查询只发送至指定 IP。管理端口为 UDP 1092。" Foreground="{DynamicResource Muted}" FontSize="11" Margin="0,14,0,0" TextWrapping="Wrap" />
          <Border Background="{DynamicResource Input}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="7" Padding="12" Margin="0,16,0,14"><StackPanel><TextBlock x:Name="NetworkConfigStatus" Text="{Binding Status}" TextWrapping="Wrap" LineHeight="21" AutomationProperties.LiveSetting="Polite"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource NetworkAccent}" /><Style.Triggers><DataTrigger Binding="{Binding HasError}" Value="True"><Setter Property="Foreground" Value="{DynamicResource ErrorAccent}" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock><ProgressBar IsIndeterminate="True" Height="3" Margin="0,10,0,0" Visibility="{Binding Busy, Converter={StaticResource BoolVisibility}}" /></StackPanel></Border>
          <DataGrid x:Name="NetworkConfigDevices" ItemsSource="{Binding Devices}" SelectedItem="{Binding Selected}" IsReadOnly="True" IsEnabled="{Binding Idle}" Height="190" local:ScrollChain.Enabled="True"><DataGrid.Columns><DataGridTextColumn Header="设备名" Binding="{Binding Name}" Width="125" /><DataGridTextColumn Header="DevID / MAC / 通道" Binding="{Binding Identity}" Width="195" /><DataGridTextColumn Header="设备 IP" Binding="{Binding Address}" Width="140" /><DataGridTextColumn Header="端口" Binding="{Binding Port}" Width="65" /><DataGridTextColumn Header="工作模式" Binding="{Binding Mode}" Width="110" /><DataGridTextColumn Header="支持状态" Binding="{Binding ProtocolState}" Width="*" /><DataGridTextColumn Header="最后应答" Binding="{Binding LastSeen}" Width="80" /></DataGrid.Columns></DataGrid>
          <TextBlock Text="{Binding CountText}" Foreground="{DynamicResource Muted}" FontSize="11" Margin="0,10,0,0" />
        </StackPanel></Border>
        <Border x:Name="NetworkConfigSettingsCard" Style="{StaticResource CardBorder}" Margin="0,0,0,16"><StackPanel>
          <DockPanel Margin="0,0,0,12"><TextBlock Text="02  设备网络与串口参数" Style="{StaticResource SectionTitle}" /><WrapPanel HorizontalAlignment="Right"><Button Content="导出模板" Command="{Binding ExportCommand}" IsEnabled="{Binding CanEdit}" /><Button Content="载入模板" Command="{Binding ImportCommand}" IsEnabled="{Binding CanEdit}" Margin="10,0,0,0" /></WrapPanel></DockPanel>
          <TextBlock Text="{Binding SelectedLabel}" Foreground="{DynamicResource NetworkAccent}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,18" />
          <StackPanel IsEnabled="{Binding CanEdit}">
            <WrapPanel><StackPanel Width="165" Margin="0,0,14,14"><TextBlock Text="设备名 / 最多 9 位 ASCII" Style="{StaticResource Caption}" /><TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" MaxLength="9" /></StackPanel><StackPanel Width="180" Margin="0,0,14,14"><TextBlock Text="工作模式" Style="{StaticResource Caption}" /><ComboBox ItemsSource="{Binding Modes}" SelectedIndex="{Binding Mode}" /></StackPanel><CheckBox Content="DHCP 自动获取 IP" IsChecked="{Binding Dhcp}" IsEnabled="{Binding CanUseDhcp}" VerticalAlignment="Center" Margin="10,10,0,0" /></WrapPanel>
            <WrapPanel><StackPanel Width="165" Margin="0,0,14,14"><TextBlock Text="设备 IP" Style="{StaticResource Caption}" /><TextBox Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}" /></StackPanel><StackPanel Width="165" Margin="0,0,14,14"><TextBlock Text="子网掩码" Style="{StaticResource Caption}" /><TextBox Text="{Binding Mask, UpdateSourceTrigger=PropertyChanged}" /></StackPanel><StackPanel Width="165" Margin="0,0,14,14"><TextBlock Text="网关 / 0.0.0.0 为无" Style="{StaticResource Caption}" /><TextBox Text="{Binding Gateway, UpdateSourceTrigger=PropertyChanged}" /></StackPanel><StackPanel Width="105" Margin="0,0,0,14"><TextBlock Text="本地端口" Style="{StaticResource Caption}" /><TextBox Text="{Binding LocalPort, UpdateSourceTrigger=PropertyChanged}" ToolTip="TCP Client 模式允许 0，表示随机分配本地端口；其他模式需填写 1–65535。" /></StackPanel></WrapPanel>
            <WrapPanel><StackPanel Width="344" Margin="0,0,14,14"><TextBlock Text="目标 IPv4 / 域名（设备需支持 DNS）" Style="{StaticResource Caption}" /><TextBox Text="{Binding Destination, UpdateSourceTrigger=PropertyChanged}" /></StackPanel><StackPanel Width="105" Margin="0,0,0,14"><TextBlock Text="目标端口" Style="{StaticResource Caption}" /><TextBox Text="{Binding DestinationPort, UpdateSourceTrigger=PropertyChanged}" /></StackPanel></WrapPanel>
            <Border Height="1" Background="{DynamicResource Line}" Margin="0,2,0,16" />
            <WrapPanel><StackPanel Width="130" Margin="0,0,14,14"><TextBlock Text="波特率" Style="{StaticResource Caption}" /><ComboBox ItemsSource="{Binding BaudRates}" SelectedItem="{Binding Baud}" /></StackPanel><StackPanel Width="90" Margin="0,0,14,14"><TextBlock Text="数据位" Style="{StaticResource Caption}" /><ComboBox ItemsSource="{Binding DataBitChoices}" SelectedItem="{Binding DataBits}" /></StackPanel><StackPanel Width="115" Margin="0,0,14,14"><TextBlock Text="校验" Style="{StaticResource Caption}" /><ComboBox ItemsSource="{Binding Parities}" SelectedIndex="{Binding Parity}" /></StackPanel><StackPanel Width="90" Margin="0,0,14,14"><TextBlock Text="停止位" Style="{StaticResource Caption}" /><ComboBox ItemsSource="{Binding StopBitChoices}" SelectedItem="{Binding StopBits}" /></StackPanel><StackPanel Width="150" Margin="0,0,0,14"><TextBlock Text="流量控制" Style="{StaticResource Caption}" /><ComboBox ItemsSource="{Binding FlowControls}" SelectedIndex="{Binding FlowControl}" /></StackPanel></WrapPanel>
            <StackPanel Width="250" HorizontalAlignment="Left" Margin="0,0,0,16"><TextBlock Text="转化协议（以设备能力为准）" Style="{StaticResource Caption}" /><ComboBox ItemsSource="{Binding AppProtocols}" SelectedIndex="{Binding AppProtocol}" /></StackPanel>
            <WrapPanel><Button Content="检查修改" Command="{Binding ReviewCommand}" Style="{StaticResource PrimaryButton}" /><Button Content="恢复读取值" Command="{Binding RestoreCommand}" Margin="10,0,0,0" /></WrapPanel>
            <StackPanel Visibility="{Binding PasswordRequired, Converter={StaticResource BoolVisibility}}" Margin="0,15,0,0" Width="240" HorizontalAlignment="Left"><TextBlock Text="设备配置密码（仅本次使用，不保存）" Style="{StaticResource Caption}" /><PasswordBox local:PasswordBinding.Value="{Binding Password, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
          </StackPanel>
          <Border Visibility="{Binding HasPreview, Converter={StaticResource BoolVisibility}}" Background="{DynamicResource Input}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,16,0,0"><StackPanel><TextBlock Text="写入预览" FontSize="15" FontWeight="SemiBold" /><TextBlock Text="{Binding Preview}" FontFamily="Consolas, Microsoft YaHei UI" TextWrapping="Wrap" Margin="0,10,0,14" LineHeight="22" /><Button Content="确认并写入设备" Command="{Binding ApplyCommand}" IsEnabled="{Binding CanApply}" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" /></StackPanel></Border>
          <TextBlock Text="保持原始参数中未编辑的字段与设备身份不变。写入会使设备重启；超时显示未确认，避免将 UDP 已发送误报为配置成功。" Foreground="{DynamicResource Muted}" FontSize="11" Margin="0,15,0,0" TextWrapping="Wrap" />
        </StackPanel></Border>
        <Border Style="{StaticResource CardBorder}"><StackPanel><DockPanel Margin="0,0,0,12"><TextBlock Text="03  操作记录" Style="{StaticResource SectionTitle}" /><Button Content="清空日志" Command="{Binding ClearLogCommand}" IsEnabled="{Binding Idle}" HorizontalAlignment="Right" /></DockPanel><TextBox x:Name="NetworkConfigLog" Text="{Binding Log, Mode=OneWay}" Style="{StaticResource CodeBox}" IsReadOnly="True" TextWrapping="NoWrap" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Height="140" local:ScrollChain.Enabled="True" /><TextBlock Text="仅记录操作与脱敏信息；参数模板不保存 DevID、原始参数或认证信息。" Foreground="{DynamicResource Muted}" FontSize="11" Margin="0,10,0,0" TextWrapping="Wrap" /></StackPanel></Border>
      </StackPanel>
    </ScrollViewer>
  </DataTemplate>
</ResourceDictionary>
